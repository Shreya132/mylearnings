#include <stdio.h>

int main() {

    int arr[6] = {3, 5, 6, 9, 2, 1};
    int target = 7;
    int count = 0;

    for (int i = 0; i < 6; i++) {

        if (arr[i] == target) {
            printf("Target found");
            count++;
        }
    }

    if (count == 0) {
        printf("Target not found");
    }

    return 0;
}
