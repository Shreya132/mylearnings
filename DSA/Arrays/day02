#include <stdio.h>

int main() {

    int arr[6] = {3, 5, 6, 9, 2, 1};
    int target = 7;
    int count = 0;

    for (int i = 0; i < 6; i++) {

        if (arr[i] == target) {
            printf("Target found");
            count++;
        }
    }

    if (count == 0) {
        printf("Target not found");
    }

    return 0;
}
#number of occurence
#include <stdio.h>

int main() {

    int nums[7] = {1, 2, 7, 4, 7, 9, 4};

    int count = 0;
    int target = 4;

    for (int i = 0; i < 7; i++) {

        if (nums[i] == target) {
            count++;
        }
    }

    printf("%d", count);

    return 0;
}

#second largest number
#include <stdio.h>

int main() {

    int nums[6] = {12, 45, 7, 89, 34, 21};

    int largest = nums[0];
    int second = nums[0];

    for (int i = 1; i < 6; i++) {

        if (nums[i] > largest) {
            second = largest;
            largest = nums[i];
        }
        else if (nums[i] > second && nums[i] < largest) {
            second = nums[i];
        }
    }

    printf("Second largest = %d", second);

    return 0;
}












